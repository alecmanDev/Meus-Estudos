rules_version = '2';
// Regras do Firestore do Meu Estudo (cole em Firebase → Firestore Database → Regras → Publicar).
// "get" permite ler um documento sabendo o código; "list" (listar todos os códigos) fica bloqueado,
// para que ninguém consiga descobrir os códigos e os dados de outras pessoas.
service cloud.firestore {
  match /databases/{database}/documents {
    match /syncs/{code} {
      allow get, write: if request.auth != null;

      match /files/{fileId} {
        allow get, delete: if request.auth != null;
        allow create, update: if request.auth != null
          && request.resource.data.d is string
          && request.resource.data.d.size() < 700000;
      }
    }
  }
}
